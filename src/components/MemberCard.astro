---
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'members'>;
  index: number;
}

const { member, index } = Astro.props;
const number = String(index + 1).padStart(3, '0');
const base = import.meta.env.BASE_URL;
const tone = `t${(index % 6) + 1}`;
---

<article class="member-card">
  <div class="card-topline">
    <span class="member-number">MEMBER / {number}</span>
    <span class="card-arrow" aria-hidden="true">↗</span>
  </div>
  <div class={`monogram monogram-${tone}`} aria-hidden="true">{member.data.monogram}</div>
  <div class="member-content">
    <p class="member-role">{member.data.role}</p>
    <h3>
      <a href={`${base}members/${member.id}/`}>{member.data.name}</a>
    </h3>
    <p class="member-bio">{member.data.bio}</p>
  </div>
  <div class="card-footer">
    <ul class="tags" aria-label="关注方向">
      {member.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
    </ul>
    <span class="profile-label">PROFILE</span>
  </div>
</article>

<style>
  .member-card {
    position: relative;
    display: flex;
    min-height: 420px;
    flex-direction: column;
    padding: 26px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: linear-gradient(160deg, rgb(255 255 255 / 3%), rgb(255 255 255 / 0%)), var(--bg-2);
    transition: border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }

  .member-card:hover {
    transform: translateY(-4px);
    border-color: var(--line-bright);
    box-shadow: 0 18px 48px rgb(0 0 0 / 35%), 0 0 0 1px rgb(110 231 255 / 8%);
  }

  .card-topline,
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .member-number,
  .profile-label {
    color: var(--dim);
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
  }

  .card-arrow {
    color: var(--dim);
    font-size: 1.15rem;
    transition: color 200ms ease, transform 200ms ease;
  }

  .member-card:hover .card-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .monogram {
    display: grid;
    width: 84px;
    height: 84px;
    margin: 40px 0 32px;
    place-items: center;
    border: 1px solid var(--line-bright);
    border-radius: 10px;
    font-family: var(--mono);
    font-size: 1.4rem;
    font-weight: 750;
    letter-spacing: -0.06em;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 5%);
  }

  .monogram-t1 { background: rgb(125 211 252 / 10%); color: var(--t1); border-color: rgb(125 211 252 / 30%); }
  .monogram-t2 { background: rgb(167 139 250 / 10%); color: var(--t2); border-color: rgb(167 139 250 / 30%); }
  .monogram-t3 { background: rgb(244 114 182 / 10%); color: var(--t3); border-color: rgb(244 114 182 / 30%); }
  .monogram-t4 { background: rgb(74 222 128 / 10%); color: var(--t4); border-color: rgb(74 222 128 / 30%); }
  .monogram-t5 { background: rgb(251 191 36 / 10%); color: var(--t5); border-color: rgb(251 191 36 / 30%); }
  .monogram-t6 { background: rgb(251 113 133 / 10%); color: var(--t6); border-color: rgb(251 113 133 / 30%); }

  .member-role {
    margin-bottom: 8px;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.67rem;
    line-height: 1.5;
  }

  h3 {
    margin-bottom: 12px;
    color: var(--text);
    font-size: 1.8rem;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .member-bio {
    margin-bottom: 28px;
    color: var(--dim);
    font-size: 0.9rem;
    line-height: 1.75;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 3px 8px;
    border: 1px solid var(--line-bright);
    border-radius: 3px;
    background: var(--bg-3);
    color: var(--dim);
    font-family: var(--mono);
    font-size: 0.62rem;
  }
</style>

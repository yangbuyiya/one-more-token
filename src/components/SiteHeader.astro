---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={`${base}#top`} aria-label="One More Token 首页">
      <span class="brand-mark" aria-hidden="true">
        <span class="mark-glyph">+1</span>
        <span class="mark-cursor" aria-hidden="true"></span>
      </span>
      <span class="brand-type">
        <strong>{site.nameEn}</strong>
        <small>{site.nameZh}</small>
      </span>
    </a>

    <nav class="navigation" aria-label="主导航">
      <a href={`${base}#manifesto`}>理念</a>
      <a href={`${base}#members`}>成员</a>
      <a href={`${base}join/`}>参与</a>
    </nav>

    <a class="repository" href={site.githubUrl} target="_blank" rel="noreferrer">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" fill="currentColor" />
      </svg>
      <span>GitHub</span>
      <span class="sr-only">（新窗口打开）</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgb(120 130 160 / 12%);
    background: rgb(6 7 12 / 72%);
    backdrop-filter: blur(18px) saturate(160%);
  }

  .header-inner {
    display: grid;
    min-height: 72px;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 12px;
  }

  .brand-mark {
    position: relative;
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid rgb(110 231 255 / 30%);
    border-radius: 6px;
    background: linear-gradient(140deg, rgb(110 231 255 / 14%), rgb(167 139 250 / 12%));
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 800;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 6%);
  }

  .mark-cursor {
    position: absolute;
    right: 5px;
    bottom: 6px;
    width: 5px;
    height: 12px;
    background: var(--accent);
    animation: caret 1.1s step-end infinite;
  }

  @keyframes caret {
    50% { opacity: 0; }
  }

  .brand-type {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-type strong {
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .brand-type small {
    margin-top: 5px;
    color: var(--dim);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
  }

  .navigation {
    display: flex;
    align-items: center;
    gap: 30px;
    font-family: var(--mono);
    font-size: 0.76rem;
  }

  .navigation a,
  .repository {
    color: var(--dim);
    transition: color 150ms ease;
  }

  .navigation a:hover,
  .repository:hover {
    color: var(--accent);
  }

  .repository {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--line-bright);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .repository:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .header-inner {
      min-height: 64px;
      grid-template-columns: 1fr auto;
      gap: 16px;
    }

    .navigation {
      display: none;
    }

    .brand-type strong {
      font-size: 0.66rem;
    }
  }
</style>

---
import { site } from '../data/site';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/#top" aria-label="One More Token 首页">
      <span class="brand-mark" aria-hidden="true">+1</span>
      <span class="brand-type">
        <strong>{site.nameEn}</strong>
        <small>{site.nameZh}</small>
      </span>
    </a>

    <nav class="navigation" aria-label="主导航">
      <a href="/#manifesto">理念</a>
      <a href="/#members">成员</a>
      <a href="/join/">参与</a>
    </nav>

    <a class="repository" href={site.githubUrl} target="_blank" rel="noreferrer">
      <span>GitHub</span>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M4 12 12 4M5 4h7v7" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
      <span class="sr-only">（新窗口打开）</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: rgb(243 240 233 / 88%);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    display: grid;
    min-height: 76px;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 12px;
  }

  .brand-mark {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 3px;
    background: var(--dark);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 800;
  }

  .brand-type {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-type strong {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .brand-type small {
    margin-top: 5px;
    color: var(--muted);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
  }

  .navigation {
    display: flex;
    align-items: center;
    gap: 32px;
    font-family: var(--mono);
    font-size: 0.76rem;
  }

  .navigation a,
  .repository {
    transition: color 150ms ease;
  }

  .navigation a:hover,
  .repository:hover {
    color: var(--accent-dark);
  }

  .repository {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 7px;
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .header-inner {
      min-height: 68px;
      grid-template-columns: 1fr auto;
      gap: 16px;
    }

    .navigation {
      display: none;
    }

    .brand-type strong {
      font-size: 0.66rem;
    }
  }
</style>

---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-statement">
      <span class="footer-kicker">THE NEXT TOKEN IS OURS.</span>
      <p>一词未尽，<span class="grad-text">继续生成。</span></p>
      <div class="footer-tokens" aria-hidden="true">
        <span class="tok t1">one</span><span class="tok t2">·more</span><span class="tok t3">·token</span><span class="tok t4">→</span><span class="tok t5">comm</span><span class="tok t6">unity</span><span class="tok t1">▍</span>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {year} {site.nameEn}. Built in the open.</p>
      <div class="footer-links">
        <a href={`${base}join/`}>成员维护指南</a>
        <a href={site.githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href="#top">回到顶部 ↑</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 120px;
    padding: 84px 0 30px;
    border-top: 1px solid var(--line);
    background:
      radial-gradient(ellipse 60% 80% at 50% 120%, rgb(110 231 255 / 5%), transparent),
      var(--bg-2);
  }

  .footer-statement {
    padding-bottom: 64px;
  }

  .footer-kicker {
    color: var(--dim);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
  }

  .footer-statement p {
    margin: 24px 0 0;
    color: var(--text);
    font-size: clamp(2.5rem, 7vw, 6.4rem);
    font-weight: 580;
    letter-spacing: -0.065em;
    line-height: 1.05;
  }

  .footer-tokens {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 28px;
  }

  .tok {
    padding: 3px 8px;
    border: 1px solid var(--line-bright);
    border-radius: 3px;
    background: var(--bg-3);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .t1 { color: var(--t1); }
  .t2 { color: var(--t2); }
  .t3 { color: var(--t3); }
  .t4 { color: var(--t4); }
  .t5 { color: var(--t5); }
  .t6 { color: var(--t6); }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--dim);
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .site-footer {
      margin-top: 80px;
      padding-top: 60px;
    }

    .footer-statement {
      padding-bottom: 48px;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-links {
      gap: 16px;
    }
  }
</style>

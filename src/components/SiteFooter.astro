---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-statement">
      <span class="footer-kicker">THE NEXT TOKEN IS OURS.</span>
      <p>一词未尽，<span>继续生成。</span></p>
    </div>
    <div class="footer-bottom">
      <p>© {year} {site.nameEn}. Built in the open.</p>
      <div class="footer-links">
        <a href={`${base}join/`}>成员维护指南</a>
        <a href={site.githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href="#top">回到顶部 ↑</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 112px;
    padding: 72px 0 28px;
    background: var(--dark);
    color: var(--white);
  }

  .footer-statement {
    padding-bottom: 64px;
  }

  .footer-kicker {
    color: #a6a79f;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .footer-statement p {
    margin: 24px 0 0;
    font-size: clamp(2.5rem, 7vw, 6.4rem);
    font-weight: 580;
    letter-spacing: -0.065em;
    line-height: 1.05;
  }

  .footer-statement p span {
    color: var(--accent);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid #3d3e38;
    color: #a6a79f;
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .footer-links a:hover {
    color: var(--white);
  }

  @media (max-width: 720px) {
    .site-footer {
      margin-top: 72px;
      padding-top: 56px;
    }

    .footer-statement {
      padding-bottom: 48px;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-links {
      gap: 16px;
    }
  }
</style>

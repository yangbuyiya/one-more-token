---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberCard from '../components/MemberCard.astro';
import { site } from '../data/site';

const members = await getCollection('members', ({ data }) => !data.draft);
members.sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Independent AI open-source community</span>
        <h1>One More<br />Token<span class="accent">.</span></h1>
        <p class="hero-zh">一词未尽，继续生成。</p>
        <p class="hero-description">
          一个由朋友发起、向所有创造者开放的 AI 开源社区。<br />
          分享真实经验，构建有趣项目，让每个人的下一个想法都有回响。
        </p>
        <div class="hero-actions">
          <a class="button button-dark" href="#members">认识社区成员 <span aria-hidden="true">↓</span></a>
          <a class="button button-light" href={`${base}join/`}>一起构建 <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="terminal" aria-label="持续创造、分享与协作的终端动画">
        <div class="terminal-bar">
          <div class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></div>
          <span>community/generation.log</span>
          <span>LIVE</span>
        </div>
        <div class="terminal-body">
          <p class="terminal-comment">// 开源不是终点，是下一次生成的上下文</p>
          <div class="code-line"><span class="line-number">01</span><code><span class="code-purple">const</span> community = <span class="code-orange">create</span>({'{'} open: <span class="code-green">true</span> {'}'});</code></div>
          <div class="code-line"><span class="line-number">02</span><code>community.<span class="code-orange">share</span>(ideas);</code></div>
          <div class="code-line"><span class="line-number">03</span><code>community.<span class="code-orange">build</span>(together);</code></div>
          <div class="code-line"><span class="line-number">04</span><code><span class="code-purple">while</span> (curious) {'{'}</code></div>
          <div class="code-line indented"><span class="line-number">05</span><code>make(<span class="code-green">"one more token"</span>);</code></div>
          <div class="code-line"><span class="line-number">06</span><code>{'}'}</code></div>
          <div class="token-output">
                        <span>OUTPUT</span>
            <p>idea<span> → </span>code<span> → </span>community<span> → </span><strong>+1</strong><i class="cursor" aria-hidden="true"></i></p>
          </div>
        </div>
      </div>
    </div>
    <div class="container hero-footnote">
      <span>OPEN BY DEFAULT</span>
      <span>BUILT BY MEMBERS</span>
      <span>ALWAYS +1</span>
    </div>
  </section>

  <section class="manifesto" id="manifesto">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">01 / Why we exist</span>
          <h2>不只预测下一个词元，<br />也认真构建它。</h2>
        </div>
        <p class="section-note">AI 不应该只是被消费的技术。它也可以是一群人共同理解、共同改造、共同分享的材料。</p>
      </div>

      <div class="principles">
        <article>
          <span class="principle-number">01</span>
          <h3>真实，胜过热闹</h3>
          <p>分享亲手做过的东西、踩过的坑和仍然不确定的问题。不追逐每一个热点，保留独立判断。</p>
        </article>
        <article>
          <span class="principle-number">02</span>
          <h3>开放，不止代码</h3>
          <p>代码、经验、过程与失败都值得被看见。让知识可以自由流动，让贡献者得到真实署名。</p>
        </article>
        <article>
          <span class="principle-number">03</span>
          <h3>朋友，成为同路人</h3>
          <p>从几个朋友开始，向更多伙伴开放。没有旁观者门槛，每个人都能带来自己的那一个 Token。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="members-section" id="members">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">02 / Members</span>
          <h2>各自创造，彼此成就。</h2>
        </div>
        <p class="section-note">每位成员独立维护自己的 Markdown。人的故事，不应该藏在一份需要反复协调的表格里。</p>
      </div>

      <div class="member-grid">
        {members.map((member, index) => <MemberCard member={member} index={index} />)}
        <article class="join-card">
          <span class="join-plus" aria-hidden="true">+</span>
          <div>
            <p class="join-label">NEXT MEMBER</p>
            <h3>下一位，<br />也许是你。</h3>
            <p>带来你的好奇心、经验和正在构建的东西。剩下的，我们一起完成。</p>
          </div>
          <a class="text-link" href={`${base}join/`}>创建我的成员页 <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </div>
  </section>

  <section class="contribute">
    <div class="container contribute-panel">
      <div class="contribute-copy">
        <span class="eyebrow">03 / Your turn</span>
        <h2>你的下一个 Token，<br />从这里开始。</h2>
        <p>复制一份成员模板，写下你自己。通过 Pull Request，让社区认识你。</p>
        <a class="button contribute-button" href={`${base}join/`}>查看参与指南 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="contribute-code">
        <div class="snippet-head"><span>QUICK START</span><span>MARKDOWN</span></div>
        <pre><code>$ cp members/_template.md members/you.md
$ edit members/you.md
$ git commit -m "Add member: you"
$ git push</code></pre>
        <a href={site.githubUrl} target="_blank" rel="noreferrer">在 GitHub 上查看项目 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 88px 0 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(360px, 0.94fr);
    align-items: center;
    gap: clamp(40px, 7vw, 96px);
  }

  h1 {
    margin-bottom: 24px;
    font-family: var(--mono);
    font-size: clamp(4rem, 8.2vw, 7.7rem);
    font-weight: 750;
    letter-spacing: -0.085em;
    line-height: 0.88;
  }

  .accent {
    color: var(--accent);
  }

  .hero-zh {
    margin-bottom: 22px;
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    font-weight: 570;
    letter-spacing: -0.04em;
  }

  .hero-description {
    max-width: 570px;
    margin-bottom: 32px;
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .terminal {
    position: relative;
    overflow: hidden;
    border: 1px solid #383931;
    border-radius: 6px;
    background: var(--dark);
    box-shadow: 18px 22px 0 var(--paper-deep);
    color: #e8e6dd;
    transform: rotate(1.2deg);
  }

  .terminal::after {
    position: absolute;
    right: -60px;
    bottom: -100px;
    width: 260px;
    height: 260px;
    border: 1px solid rgb(240 85 50 / 28%);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

  .terminal-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 13px 16px;
    border-bottom: 1px solid #393a33;
    color: #96988d;
    font-family: var(--mono);
    font-size: 0.6rem;
  }

  .terminal-bar > :last-child {
    justify-self: end;
    color: var(--accent);
  }

  .terminal-dots {
    display: flex;
    gap: 5px;
  }

  .terminal-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #55574e;
  }

  .terminal-dots span:first-child {
    background: var(--accent);
  }

  .terminal-body {
    padding: clamp(24px, 4vw, 42px);
    font-family: var(--mono);
    font-size: clamp(0.62rem, 1vw, 0.77rem);
  }

  .terminal-comment {
    margin-bottom: 32px;
    color: #7e8075;
    line-height: 1.7;
  }

  .code-line {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 12px;
    margin: 13px 0;
  }

  .line-number {
    color: #55574e;
    user-select: none;
  }

  .indented code {
    padding-left: 22px;
  }

  .code-purple {
    color: #c2a7ef;
  }

  .code-orange {
    color: #ff8668;
  }

  .code-green {
    color: #a9c99a;
  }

  .token-output {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px dashed #45463f;
  }

  .token-output > span {
    color: #77796e;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
  }

  .token-output p {
    margin: 12px 0 0;
    line-height: 1.8;
  }

  .token-output p span {
    color: #686a5f;
  }

  .token-output strong {
    color: var(--accent);
  }

  .cursor {
    display: inline-block;
    width: 7px;
    height: 1.05em;
    margin-left: 5px;
    background: var(--accent);
    vertical-align: -0.15em;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero-footnote {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 88px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }

  .manifesto,
  .members-section,
  .contribute {
    margin-top: 112px;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .principles article {
    padding: 32px;
  }

  .principles article + article {
    border-left: 1px solid var(--line);
  }

  .principle-number {
    display: block;
    margin-bottom: 52px;
    color: var(--accent-dark);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .principles h3 {
    margin-bottom: 14px;
    font-size: 1.35rem;
    letter-spacing: -0.035em;
  }

  .principles p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.85;
  }

  .member-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .join-card {
    display: flex;
    min-height: 420px;
    flex-direction: column;
    justify-content: space-between;
    padding: 32px;
    border: 1px dashed #aaa89e;
    border-radius: 4px;
  }

  .join-plus {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 1.8rem;
  }

  .join-card > div {
    margin-block: 36px;
  }

  .join-label {
    margin-bottom: 14px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
  }

  .join-card h3 {
    margin-bottom: 18px;
    font-size: clamp(2rem, 4vw, 3.3rem);
    letter-spacing: -0.055em;
    line-height: 1.08;
  }

  .join-card div > p:last-child {
    max-width: 360px;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .join-card .text-link {
    width: fit-content;
  }

  .contribute-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    padding: clamp(32px, 5vw, 64px);
    border-radius: 5px;
    background: var(--dark);
    color: var(--white);
  }

  .contribute-copy .eyebrow {
    color: #a6a79f;
  }

  .contribute-copy h2 {
    margin-bottom: 24px;
    font-size: clamp(2rem, 4vw, 3.8rem);
    letter-spacing: -0.055em;
    line-height: 1.1;
  }

  .contribute-copy > p {
    max-width: 440px;
    margin-bottom: 32px;
    color: #b5b6ad;
    font-size: 0.92rem;
  }

  .contribute-button {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--white);
  }

  .contribute-button:hover {
    background: #ff6c49;
  }

  .contribute-code {
    align-self: center;
    overflow: hidden;
    border: 1px solid #44453e;
    border-radius: 4px;
    background: #22231f;
  }

  .snippet-head {
    display: flex;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid #44453e;
    color: #8d8f83;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
  }

  .contribute-code pre {
    margin: 0;
    overflow-x: auto;
    padding: 28px 20px;
    color: #e8e6dd;
    font-family: var(--mono);
    font-size: clamp(0.65rem, 1.2vw, 0.78rem);
    line-height: 2;
  }

  .contribute-code > a {
    display: block;
    padding: 14px 20px;
    border-top: 1px solid #44453e;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.68rem;
  }

  @media (max-width: 940px) {
    .hero {
      padding-top: 64px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      max-width: 760px;
    }

    .terminal {
      max-width: 680px;
      margin-top: 16px;
      transform: none;
    }

    .principles article {
      padding: 24px;
    }

    .contribute-panel {
      gap: 36px;
    }
  }

  @media (max-width: 720px) {
    h1 {
      font-size: clamp(3.8rem, 18vw, 6rem);
    }

    .hero-description br {
      display: none;
    }

    .hero-footnote {
      gap: 12px;
      margin-top: 64px;
      font-size: 0.54rem;
      letter-spacing: 0.03em;
    }

    .manifesto,
    .members-section,
    .contribute {
      margin-top: 80px;
    }

    .principles {
      grid-template-columns: 1fr;
    }

    .principles article + article {
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .principle-number {
      margin-bottom: 24px;
    }

    .member-grid,
    .contribute-panel {
      grid-template-columns: 1fr;
    }

    .member-card,
    .join-card {
      min-height: 390px;
    }
  }

  @media (max-width: 420px) {
    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .hero-actions .button {
      width: 100%;
    }

    .terminal-body {
      padding: 20px 16px;
    }

    .code-line {
      grid-template-columns: 20px 1fr;
      gap: 6px;
    }
  }
</style>

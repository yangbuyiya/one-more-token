---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberCard from '../components/MemberCard.astro';
import { site } from '../data/site';

const members = await getCollection('members', ({ data }) => !data.draft);
members.sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
const base = import.meta.env.BASE_URL;

// “一词未尽，继续生成。” 的 token 分词可视化
const tokens = [
  { text: 'one', id: 4023 },
  { text: '·more', id: 1768 },
  { text: '·token', id: 9614 },
  { text: '—', id: 511 },
  { text: '一', id: 8837 },
  { text: '词', id: 2262 },
  { text: '未', id: 4470 },
  { text: '尽', id: 6908 },
  { text: '，', id: 264 },
  { text: '继', id: 5311 },
  { text: '续', id: 1209 },
  { text: '生', id: 8843 },
  { text: '成', id: 3306 },
  { text: '。', id: 1050 },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-head">
      <span class="eyebrow">AI Open-Source Community</span>
      <h1>One More <span class="grad-text">Token</span>.</h1>
      <p class="hero-zh">一词未尽，继续生成。</p>
      <p class="hero-description">
        一个由朋友发起、向所有创造者开放的 AI 开源社区。<br />
        分享真实经验，构建有趣项目，让每个人的下一个想法都有回响。
      </p>
      <div class="hero-actions">
        <a class="button button-dark" href="#members">认识社区成员 <span aria-hidden="true">↓</span></a>
        <a class="button button-light" href={`${base}join/`}>一起构建 <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="container tokenizer" aria-label="一词未尽的 token 分词可视化">
      <div class="tokenizer-bar">
        <div class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <span class="tokenizer-title">tokenizer · input / output</span>
        <span class="tokenizer-live"><i aria-hidden="true"></i>LIVE</span>
      </div>
      <div class="tokenizer-input">
        <span class="prompt-sign">$</span>
        <code>tokenize(&quot;One More Token — 一词未尽，继续生成。&quot;)</code>
      </div>
      <div class="tokenizer-output">
        {tokens.map((token, i) => (
          <span class={`tok tok-${(i % 6) + 1}`} style={`animation-delay:${0.12 * i + 0.2}s`}>
            <span class="tok-id">#{token.id}</span>
            <span class="tok-text">{token.text}</span>
          </span>
        ))}
        <span class="cursor" style={`animation-delay:${0.12 * tokens.length + 0.2}s`} aria-hidden="true"></span>
      </div>
      <div class="tokenizer-meta">
        <span>14 tokens</span>
        <span>context ∞</span>
        <span>always +1</span>
      </div>
    </div>
  </section>

  <section class="manifesto" id="manifesto">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">01 / Why we exist</span>
          <h2>不只预测下一个词元，<br />也认真构建它。</h2>
        </div>
        <p class="section-note">AI 不应该只是被消费的技术。它也可以是一群人共同理解、共同改造、共同分享的材料。</p>
      </div>

      <div class="principles">
        <article>
          <span class="principle-number">01</span>
          <h3>真实，胜过热闹</h3>
          <p>分享亲手做过的东西、踩过的坑和仍然不确定的问题。不追逐每一个热点，保留独立判断。</p>
        </article>
        <article>
          <span class="principle-number">02</span>
          <h3>开放，不止代码</h3>
          <p>代码、经验、过程与失败都值得被看见。让知识可以自由流动，让贡献者得到真实署名。</p>
        </article>
        <article>
          <span class="principle-number">03</span>
          <h3>朋友，成为同路人</h3>
          <p>从几个朋友开始，向更多伙伴开放。没有旁观者门槛，每个人都能带来自己的那一个 Token。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="members-section" id="members">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">02 / Members</span>
          <h2>各自创造，彼此成就。</h2>
        </div>
        <p class="section-note">每位成员独立维护自己的 Markdown。人的故事，不应该藏在一份需要反复协调的表格里。</p>
      </div>

      <div class="member-grid">
        {members.map((member, index) => <MemberCard member={member} index={index} />)}
        <article class="join-card">
          <span class="join-plus" aria-hidden="true">+</span>
          <div>
            <p class="join-label">NEXT MEMBER</p>
            <h3>下一位，<br />也许是你。</h3>
            <p>带来你的好奇心、经验和正在构建的东西。剩下的，我们一起完成。</p>
          </div>
          <a class="text-link" href={`${base}join/`}>创建我的成员页 <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </div>
  </section>

  <section class="contribute">
    <div class="container contribute-panel">
      <div class="contribute-copy">
        <span class="eyebrow">03 / Your turn</span>
        <h2>你的下一个 Token，<br />从这里开始。</h2>
        <p>复制一份成员模板，写下你自己。通过 Pull Request，让社区认识你。</p>
        <a class="button contribute-button" href={`${base}join/`}>查看参与指南 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="contribute-code">
        <div class="snippet-head"><span>QUICK START</span><span>MARKDOWN</span></div>
        <pre><code>$ cp members/_template.md members/you.md
$ edit members/you.md
$ git commit -m "Add member: you"
$ git push</code></pre>
        <a href={site.githubUrl} target="_blank" rel="noreferrer">在 GitHub 上查看项目 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 96px 0 0;
  }

  .hero-head {
    max-width: 860px;
  }

  h1 {
    margin-bottom: 24px;
    font-family: var(--mono);
    font-size: clamp(3.4rem, 9vw, 8rem);
    font-weight: 750;
    letter-spacing: -0.075em;
    line-height: 0.92;
  }

  .hero-zh {
    margin-bottom: 22px;
    color: var(--text);
    font-size: clamp(1.5rem, 2.6vw, 2.3rem);
    font-weight: 570;
    letter-spacing: -0.04em;
  }

  .hero-description {
    max-width: 620px;
    margin-bottom: 36px;
    color: var(--dim);
    font-size: 1rem;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ============ Tokenizer 可视化面板（一词未尽核心视觉） ============ */
  .tokenizer {
    margin-top: 72px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: linear-gradient(180deg, rgb(255 255 255 / 3%), rgb(255 255 255 / 0%)), var(--bg-2);
    box-shadow: 0 24px 60px rgb(0 0 0 / 30%);
  }

  .tokenizer-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.62rem;
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .terminal-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #2c3245;
  }

  .terminal-dots span:first-child { background: var(--t6); }
  .terminal-dots span:nth-child(2) { background: var(--t5); }
  .terminal-dots span:nth-child(3) { background: var(--t4); }

  .tokenizer-title {
    color: var(--dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tokenizer-live {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 7px;
    color: var(--t4);
  }

  .tokenizer-live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--t4);
    box-shadow: 0 0 10px var(--t4);
    animation: pulse 1.6s ease-in-out infinite;
  }

  @keyframes pulse {
    50% { opacity: 0.35; }
  }

  .tokenizer-input {
    display: flex;
    gap: 12px;
    padding: 22px 22px 0;
    color: var(--t2);
    font-family: var(--mono);
    font-size: clamp(0.72rem, 1.4vw, 0.85rem);
  }

  .prompt-sign {
    color: var(--t3);
    user-select: none;
  }

  .tokenizer-input code {
    color: var(--dim);
  }

  .tokenizer-output {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 24px 22px 8px;
  }

  .tok {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 12px 7px;
    border: 1px solid var(--line-bright);
    border-radius: 6px;
    background: var(--bg-3);
    font-family: var(--mono);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 5%);
    opacity: 0;
    animation: tok-in 0.5s cubic-bezier(0.2, 0.7, 0.3, 1.2) both;
  }

  @keyframes tok-in {
    from { opacity: 0; transform: translateY(10px) scale(0.92); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .tok-id {
    font-size: 0.55rem;
    letter-spacing: 0.05em;
    color: var(--dim);
  }

  .tok-text {
    font-size: 0.95rem;
    font-weight: 650;
  }

  .tok-1 { color: var(--t1); border-color: rgb(125 211 252 / 30%); }
  .tok-2 { color: var(--t2); border-color: rgb(167 139 250 / 30%); }
  .tok-3 { color: var(--t3); border-color: rgb(244 114 182 / 30%); }
  .tok-4 { color: var(--t4); border-color: rgb(74 222 128 / 30%); }
  .tok-5 { color: var(--t5); border-color: rgb(251 191 36 / 30%); }
  .tok-6 { color: var(--t6); border-color: rgb(251 113 133 / 30%); }

  .cursor {
    align-self: center;
    width: 9px;
    height: 26px;
    margin-left: 2px;
    background: var(--accent);
    box-shadow: 0 0 14px var(--accent);
    opacity: 0;
    animation: caret 1.1s step-end infinite;
  }

  @keyframes caret {
    50% { opacity: 0; }
  }

  .tokenizer-meta {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 18px;
    padding: 16px 22px;
    border-top: 1px dashed var(--line-bright);
    color: var(--dim);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }

  /* ============ 理念区 ============ */
  .manifesto,
  .members-section,
  .contribute {
    margin-top: 112px;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--line);
    overflow: hidden;
  }

  .principles article {
    padding: 32px;
    background: var(--bg-2);
  }

  .principle-number {
    display: block;
    margin-bottom: 52px;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .principles h3 {
    margin-bottom: 14px;
    color: var(--text);
    font-size: 1.35rem;
    letter-spacing: -0.035em;
  }

  .principles p {
    margin-bottom: 0;
    color: var(--dim);
    font-size: 0.9rem;
    line-height: 1.85;
  }

  /* ============ 成员区 ============ */
  .member-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .join-card {
    display: flex;
    min-height: 420px;
    flex-direction: column;
    justify-content: space-between;
    padding: 26px;
    border: 1px dashed var(--line-bright);
    border-radius: 10px;
    background: rgb(255 255 255 / 2%);
  }

  .join-plus {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border: 1px solid rgb(110 231 255 / 35%);
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 1.8rem;
  }

  .join-card > div {
    margin-block: 36px;
  }

  .join-label {
    margin-bottom: 14px;
    color: var(--dim);
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
  }

  .join-card h3 {
    margin-bottom: 18px;
    color: var(--text);
    font-size: clamp(2rem, 4vw, 3.3rem);
    letter-spacing: -0.055em;
    line-height: 1.08;
  }

  .join-card div > p:last-child {
    max-width: 360px;
    margin-bottom: 0;
    color: var(--dim);
    font-size: 0.9rem;
  }

  .join-card .text-link {
    width: fit-content;
  }

  /* ============ 参与区 ============ */
  .contribute-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    padding: clamp(32px, 5vw, 64px);
    border: 1px solid var(--line);
    border-radius: 12px;
    background:
      radial-gradient(ellipse 80% 90% at 0% 0%, rgb(167 139 250 / 7%), transparent),
      var(--bg-2);
  }

  .contribute-copy h2 {
    margin-bottom: 24px;
    color: var(--text);
    font-size: clamp(2rem, 4vw, 3.8rem);
    letter-spacing: -0.055em;
    line-height: 1.1;
  }

  .contribute-copy > p {
    max-width: 440px;
    margin-bottom: 32px;
    color: var(--dim);
    font-size: 0.92rem;
  }

  .contribute-code {
    align-self: center;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
  }

  .snippet-head {
    display: flex;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--dim);
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
  }

  .contribute-code pre {
    margin: 0;
    overflow-x: auto;
    padding: 28px 20px;
    color: var(--t4);
    font-family: var(--mono);
    font-size: clamp(0.65rem, 1.2vw, 0.78rem);
    line-height: 2;
  }

  .contribute-code > a {
    display: block;
    padding: 14px 20px;
    border-top: 1px solid var(--line);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.68rem;
  }

  .contribute-code > a:hover {
    background: var(--accent-soft);
  }

  @media (max-width: 940px) {
    .hero {
      padding-top: 72px;
    }

    .contribute-panel {
      gap: 36px;
    }
  }

  @media (max-width: 720px) {
    h1 {
      font-size: clamp(3.2rem, 17vw, 6rem);
    }

    .hero-description br {
      display: none;
    }

    .tokenizer-meta {
      gap: 12px;
      font-size: 0.56rem;
    }

    .manifesto,
    .members-section,
    .contribute {
      margin-top: 80px;
    }

    .principles {
      grid-template-columns: 1fr;
    }

    .principle-number {
      margin-bottom: 24px;
    }

    .member-grid,
    .contribute-panel {
      grid-template-columns: 1fr;
    }

    .member-card,
    .join-card {
      min-height: 390px;
    }
  }

  @media (max-width: 420px) {
    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .hero-actions .button {
      width: 100%;
    }

    .tokenizer-output {
      padding: 18px 16px 8px;
    }
  }
</style>
